---
import { profile } from '../data/profile';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';
import TechnologyIcon from './TechnologyIcon.astro';
---
<section id="tecnologias" class="section-grid" aria-labelledby="technologies-title" tabindex="-1">
  <SectionTitle number="02" title="Tecnologías" subtitle="Las herramientas con las que trabajo." id="technologies-title" />
  <div class="skills-grid">
    {profile.skills.map((group) => <article class="skill-card">
      <Icon name={group.icon} size={23} />
      <h3>{group.title}</h3>
      <ul class="technology-list">
        {group.items.map((item) => <li><TechnologyIcon name={item} /><span class="technology-name">{item}</span></li>)}
      </ul>
    </article>)}
  </div>
</section>
