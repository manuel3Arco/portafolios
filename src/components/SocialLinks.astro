---
import { profile } from '../data/profile';
import { publication } from '../../config/deployment.mjs';
import { externalUrl } from '../lib/urls';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
interface Props { withBrandIcons?: boolean }
const { withBrandIcons = false } = Astro.props;
const linkedin = externalUrl(profile.linkedin);
---
{publication.githubUrl && <a href={publication.githubUrl} target="_blank" rel="noopener noreferrer">{withBrandIcons && <BrandIcon name="github" />}GitHub<Icon name="arrow" size={16} /><span class="sr-only"> (nueva pestaña)</span></a>}
{linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">{withBrandIcons && <BrandIcon name="linkedin" />}LinkedIn<Icon name="arrow" size={16} /><span class="sr-only"> (nueva pestaña)</span></a>}
