---
import BaseLayout from '../layouts/BaseLayout.astro';
import { assetUrl } from '../lib/urls';
import { profile } from '../data/profile';
import Icon from '../components/Icon.astro';
---
<BaseLayout title={`Página no encontrada · ${profile.name}`} notFound><section class="not-found"><p class="eyebrow">ERROR 404</p><h1>Esta página no está aquí<span>.</span></h1><p>Puede que el enlace haya cambiado. Puedes volver al portafolio para continuar.</p><a class="button button-primary" href={assetUrl('')}>Volver al inicio <Icon name="right" /></a></section></BaseLayout>
