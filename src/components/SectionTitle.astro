---
interface Props { number: string; title: string; subtitle?: string; id: string }
const { number, title, subtitle, id } = Astro.props;
---
<div class="section-heading">
  <span class="section-number" aria-hidden="true">{number} /</span>
  <h2 id={id}>{title}</h2>
  {subtitle && <p>{subtitle}</p>}
</div>
